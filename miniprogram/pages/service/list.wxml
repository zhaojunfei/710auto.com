<view class="container">
  <input class="search" placeholder="{{T.services}}" confirm-type="search" bindconfirm="onSearch" />

  <scroll-view scroll-x class="filters">
    <view class="filter {{categoryId === null ? 'active' : ''}}" data-id="all" bindtap="selectCategory">全部</view>
    <view
      class="filter {{categoryId === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >{{item.categoryName}}</view>
  </scroll-view>

  <view class="grid">
    <view class="cell card service-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image class="service-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="service-name">{{item.displayName}}</view>
      <view class="muted ellipsis">{{item.description || ''}}</view>
      <view class="between">
        <text class="price">{{item.displayPrice}}</text>
        <text class="muted" wx:if="{{item.duration}}">{{item.duration}}min</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!items.length && !loading}}">暂无服务</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
