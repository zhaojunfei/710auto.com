.plate-row { display: flex; align-items: center; }
.plate-prov { width: 128rpx; flex: 0 0 128rpx; margin-right: 12rpx; }
.plate-prov-inner {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
}
.plate-no {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
  text-transform: uppercase;
  box-sizing: border-box;
}
.plate-types { margin-top: 12rpx; }
.plate-radio {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: #909399;
  padding: 6rpx 20rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 32rpx;
}
.plate-radio.on { color: #fff; background: #409eff; border-color: #409eff; }
.plate-err { color: #f56c6c; font-size: 24rpx; margin-top: 8rpx; }
