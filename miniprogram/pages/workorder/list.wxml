<view class="container">
  <view class="card empty" wx:if="{{!logged}}">
    <view>登录后可查看您的工单与施工进度</view>
    <button class="btn" bindtap="login" style="margin-top:24rpx;width:60%">微信登录</button>
  </view>

  <block wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="detail">
      <view class="between">
        <text class="item-title">{{item.orderNo || ('工单 #' + item.id)}}</text>
        <text class="status">{{item.statusLabel}}</text>
      </view>
      <view class="muted">车牌：{{item.plateNo || '-'}}</view>
      <view class="muted">进店：{{item.timeLabel}}</view>
      <view class="between" style="margin-top:12rpx">
        <text class="price">{{item.amountLabel}}</text>
        <text class="muted">查看详情 ›</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length && !loading}}">{{T.empty}}</view>
  </block>
</view>
