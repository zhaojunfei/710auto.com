<view class="container">
  <view class="card">
    <view class="title" style="margin:0">{{store.storeName || '710号汽车之家'}}</view>
    <view class="spec between"><text class="muted">电话</text><text>{{store.phone || site.servicePhone || '-'}}</text></view>
    <view class="spec between"><text class="muted">营业时间</text><text>{{store.businessHours || '-'}}</text></view>
    <view class="spec between"><text class="muted">地址</text><text>{{store.address || '-'}}</text></view>
    <view class="row" style="gap:16rpx;margin-top:16rpx">
      <button class="btn ghost" bindtap="callPhone">拨打电话</button>
      <button class="btn" bindtap="openLocation">门店导航</button>
    </view>
  </view>

  <view class="card">
    <view class="title">在线留言</view>
    <label>您的称呼</label>
    <input placeholder="请输入姓名" data-field="name" value="{{form.name}}" bindinput="onInput" />
    <label>联系电话</label>
    <input type="number" placeholder="请输入手机号" data-field="phone" value="{{form.phone}}" bindinput="onInput" />
    <label>留言内容</label>
    <textarea placeholder="请描述您的需求" data-field="content" value="{{form.content}}" bindinput="onInput" />
    <button class="btn block" loading="{{sending}}" bindtap="submit" style="margin-top:24rpx">提交留言</button>
  </view>
</view>
