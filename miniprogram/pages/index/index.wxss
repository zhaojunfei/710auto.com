.banner { height: 300rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 20rpx; }
.banner-img { width: 100%; height: 300rpx; }
.lang-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.lang-item { border: 1rpx solid rgba(255,255,255,.6); border-radius: 24rpx; padding: 4rpx 20rpx; font-size: 24rpx; }
.lang-item.active { background: #fff; color: #1f6feb; border-color: #fff; }
.quick { text-align: center; }
.quick-icon { width: 88rpx; height: 88rpx; border-radius: 20rpx; background: #eaf1fe; color: #1f6feb; margin: 0 auto 10rpx; line-height: 88rpx; font-weight: 700; font-size: 34rpx; }
.quick-text { font-size: 24rpx; color: #4b5563; }
.service-card { overflow: hidden; }
.service-cover { width: 100%; height: 220rpx; border-radius: 12rpx; background: #eef2f7; margin-bottom: 12rpx; }
.service-name { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.section-title { font-size: 32rpx; font-weight: 700; margin: 28rpx 0 16rpx; }
.entry { display: flex; align-items: center; justify-content: space-between; }
.entry-title { font-size: 30rpx; font-weight: 600; }
.entry-arrow { font-size: 44rpx; color: #c0c4cc; }
.article-title { font-size: 28rpx; font-weight: 600; }
