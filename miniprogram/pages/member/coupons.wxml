<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我的优惠券</view>
    <view class="tab {{tab === 'available' ? 'active' : ''}}" data-tab="available" bindtap="switchTab">领取中心</view>
  </view>

  <block wx:if="{{tab === 'mine'}}">
    <view class="coupon" wx:for="{{mine}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-value">{{item.valueLabel}}</view>
        <view class="muted">{{item.couponName || '优惠券'}}</view>
      </view>
      <view class="coupon-right">
        <view class="muted">有效期至 {{item.endLabel}}</view>
        <view class="muted">券码 {{item.couponCode || '-'}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!mine.length}}">{{T.empty}}</view>
  </block>

  <block wx:else>
    <view class="coupon" wx:for="{{available}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-value">{{item.valueLabel}}</view>
        <view class="muted">{{item.couponName}}</view>
      </view>
      <view class="coupon-right">
        <view class="muted">{{item.conditionLabel}}</view>
        <button class="btn" size="mini" data-id="{{item.id}}" bindtap="receive">领取</button>
      </view>
    </view>
    <view class="empty" wx:if="{{!available.length}}">{{T.empty}}</view>
  </block>
</view>
