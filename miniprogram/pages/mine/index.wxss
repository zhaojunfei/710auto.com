.profile { display: flex; align-items: center; flex-wrap: wrap; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: #eef2f7; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; background: #1f6feb; color: #fff; font-size: 44rpx; font-weight: 700; }
.profile-info { margin-left: 20rpx; }
.nickname { font-size: 32rpx; font-weight: 600; }
.assets { display: flex; width: 100%; margin-top: 24rpx; border-top: 1rpx solid #eef0f3; padding-top: 20rpx; }
.asset { flex: 1; text-align: center; }
.asset .num { display: block; font-size: 36rpx; font-weight: 700; color: #1f6feb; }
.asset .label { font-size: 24rpx; color: #8a8f99; }
.menu { padding: 0 24rpx; }
.menu-item { padding: 28rpx 0; border-bottom: 1rpx solid #eef0f3; }
.menu-item:last-child { border-bottom: none; }
.arrow { color: #c0c4cc; font-size: 36rpx; }
.lang-row { display: flex; gap: 12rpx; }
.lang-item { border: 1rpx solid #dcdfe6; border-radius: 24rpx; padding: 6rpx 20rpx; font-size: 24rpx; color: #6b7280; }
.lang-item.active { background: #1f6feb; border-color: #1f6feb; color: #fff; }
